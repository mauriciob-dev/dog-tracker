{
    "name": "dog-tracker",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/src/main.js",
        "simulate": "ts-node --transpile-only scripts/simulate.ts",
        "listen": "ts-node --transpile-only scripts/listen.ts"
    },
    "dependencies": {
        "@nestjs/common": "^11.0.0",
        "@nestjs/core": "^11.0.0",
        "@nestjs/platform-express": "^11.0.0",
        "@nestjs/platform-socket.io": "^11.0.0",
        "@nestjs/platform-ws": "^11.2.9",
        "@nestjs/websockets": "^11.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "dotenv": "^18.0.10",
        "mqtt": "^5.10.0",
        "pg": "^8.13.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "socket.io": "^4.8.0",
        "ws": "^8.22.2"
    },
    "devDependencies": {
        "@types/express": "^5.0.0",
        "@types/node": "^22.0.0",
        "@types/pg": "^8.11.0",
        "@types/ws": "^8.18.2",
        "socket.io-client": "^4.8.0",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.6.0"
    }
}
